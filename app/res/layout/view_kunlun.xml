<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22"
        android:contentDescription="背景"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_kunlun" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/tab_kunlun"
            android:scaleType="centerCrop"
            android:src="@drawable/kunlun_bg" />

        <TextView
            android:id="@+id/kunlun_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/kunlun_title"
            android:textColor="#FB7299"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kunlun_waiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/kunlun_waiting"
            android:textColor="#6A6A72"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>